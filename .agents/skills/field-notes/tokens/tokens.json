      "reflow": "cubic-bezier(.65,0,.35,1)",
      "leave": "cubic-bezier(.32,0,.67,0)",
      "word": "cubic-bezier(.5,1,.89,1)",
      "drift": "cubic-bezier(.37,0,.63,1)",
      "clock": "linear"
    },
    "timing": {
      "micro": "120–150ms",
      "swap": "0.2s out / 0.3s in",
